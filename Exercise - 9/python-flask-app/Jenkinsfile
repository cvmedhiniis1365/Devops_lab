
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('Exercise - 9/python-flask-app') {
                    echo 'Creating virtual environment and installing dependencies...'
                    sh '''
                        python3 -m venv venv
                        ./venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('Exercise - 9/python-flask-app') {
                    echo 'Running unit tests...'
                    sh './venv/bin/python -m unittest discover -s .'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('Exercise - 9/python-flask-app') {
                    echo 'Deploying application...'
                    sh '''
                        mkdir -p python-app-deploy
                        cp app.py python-app-deploy/
                    '''
                }
            }
        }

        stage('Run Application') {
            steps {
                dir('Exercise - 9/python-flask-app') {
                    echo 'Starting Flask application...'
                    sh '''
                        nohup ./venv/bin/python python-app-deploy/app.py \
                            > python-app-deploy/app.log 2>&1 &
                        echo $! > python-app-deploy/app.pid
                        sleep 3
                        kill -0 "$(cat python-app-deploy/app.pid)"
                    '''
                }
            }
        }

        stage('Test Application') {
            steps {
                dir('Exercise - 9/python-flask-app') {
                    echo 'Testing the application...'
                    sh '''
                        ./venv/bin/python -c "
from urllib.request import urlopen
response = urlopen('http://127.0.0.1:5000/')
body = response.read().decode()
print(body)
assert response.status == 200
assert body == 'Hello, Jenkins Multi-Stage Pipeline!'
"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for details.'
        }
        always {
            dir('Exercise - 9/python-flask-app') {
                sh '''
                    if [ -f python-app-deploy/app.pid ]; then
                        kill "$(cat python-app-deploy/app.pid)" 2>/dev/null || true
                    fi
                '''
            }
        }
    }
}
