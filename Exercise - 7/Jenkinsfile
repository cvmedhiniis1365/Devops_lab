
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Starting CI pipeline'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the application'
            }
        }

        stage('Test') {
            steps {
                echo 'Running automated tests'
            }
        }

        stage('Complete') {
            steps {
                echo 'CI pipeline completed successfully'
            }
        }
    }
}
